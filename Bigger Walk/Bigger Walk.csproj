<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net6.0</TargetFramework>
        <AssemblyName>BigLobbies</AssemblyName>
        <Product>Big Lobbies</Product>
        <Authors>AdamMady</Authors>
        <Version>1.0.0</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <RestoreAdditionalProjectSources>
            https://api.nuget.org/v3/index.json;
            https://nuget.bepinex.dev/v3/index.json;
            https://nuget.samboy.dev/v3/index.json
        </RestoreAdditionalProjectSources>
        <RootNamespace>Bigger_Walk</RootNamespace>
        <GameDir Condition="'$(GameDir)' == ''">$(BIG_WALK_GAME_DIR)</GameDir>
    </PropertyGroup>

    <PropertyGroup Condition="'$(QualityTesting)' == 'true'">
        <DefineConstants>$(DefineConstants);QUALITY_TESTING</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="com.Epic.OnlineServices"><HintPath>$(GameDir)\BepInEx\interop\com.Epic.OnlineServices.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="com.playeveryware.eos.core"><HintPath>$(GameDir)\BepInEx\interop\com.playeveryware.eos.core.dll</HintPath><Private>false</Private></Reference>
        <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.*" IncludeAssets="compile"/>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*"/>
    </ItemGroup>

    <ItemGroup>
        <Reference Include="DissonanceVoip"><HintPath>$(GameDir)\BepInEx\interop\DissonanceVoip.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="UnityEngine.AudioModule"><HintPath>$(GameDir)\BepInEx\interop\UnityEngine.AudioModule.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Il2CppSystem"><HintPath>$(GameDir)\BepInEx\interop\Il2CppSystem.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Il2CppSystem.Core"><HintPath>$(GameDir)\BepInEx\interop\Il2CppSystem.Core.dll</HintPath><Private>false</Private></Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GameDir)\BepInEx\interop\Assembly-CSharp.dll</HintPath>
            <Aliases>global,GameInterop</Aliases>
        </Reference>

        <Reference Include="Mirror">
            <HintPath>$(GameDir)\BepInEx\interop\Mirror.dll</HintPath>
        </Reference>

        <Reference Include="Mirror.Transports">
            <HintPath>$(GameDir)\BepInEx\interop\Mirror.Transports.dll</HintPath>
        </Reference>

        <Reference Include="com.rlabrecque.steamworks.net">
            <HintPath>$(GameDir)\BepInEx\interop\com.rlabrecque.steamworks.net.dll</HintPath>
        </Reference>

        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.CoreModule.dll</HintPath>
        </Reference>

        <Reference Include="UniTask">
            <HintPath>$(GameDir)\BepInEx\interop\UniTask.dll</HintPath>
        </Reference>

        <Reference Include="Il2Cppmscorlib">
            <HintPath>$(GameDir)\BepInEx\interop\Il2Cppmscorlib.dll</HintPath>
        </Reference>

        <Reference Include="AudioSystem">
            <HintPath>$(GameDir)\BepInEx\interop\AudioSystem.dll</HintPath>
        </Reference>

        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.IMGUIModule.dll</HintPath>
        </Reference>

        <Reference Include="UnityEngine.InputLegacyModule">
            <HintPath>$(GameDir)\BepInEx\interop\UnityEngine.InputLegacyModule.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
